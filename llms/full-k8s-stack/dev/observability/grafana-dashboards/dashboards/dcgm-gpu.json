{
  "uid": "dcgm-gpu",
  "title": "GPU / DCGM Exporter",
  "description": "NVIDIA GPU telemetry from dcgm-exporter. Panels use only the counters enabled in the dcgm-metrics ConfigMap; DCP/profiling fields (DCGM_FI_PROF_*) are not collected on this cluster.",
  "tags": ["gpu", "dcgm", "nvidia"],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "query": { "query": "label_values(DCGM_FI_DEV_GPU_TEMP, gpu)", "refId": "A" },
        "refresh": 1,
        "sort": 3,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPUs Reporting",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "count(DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"})",
          "legendFormat": "gpus"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Avg GPU Utilization",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 40 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"})",
          "legendFormat": "avg util"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max GPU Temp",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "max(DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"})",
          "legendFormat": "max temp"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Power Draw",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "watt", "decimals": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"})",
          "legendFormat": "total watts"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Framebuffer Used",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "mbytes", "decimals": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"})",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Framebuffer Utilization",
      "description": "FB_USED / (FB_USED + FB_FREE) across the selected GPUs.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 0.85 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) / clamp_min(sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) + sum(DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}), 1)",
          "legendFormat": "fb used"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "GPU Utilization",
      "description": "Percent of time any kernel was resident. Not a measure of how well the SMs are saturated — that needs DCGM_FI_PROF_* profiling metrics.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory Copy Utilization",
      "description": "Percent of time the memory interface was busy — a proxy for memory bandwidth pressure.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_MEM_COPY_UTIL{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Framebuffer Memory Used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Framebuffer Utilization per GPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} / clamp_min(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}, 1)",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU Temperature",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Power Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "SM Clock (MHz)",
      "description": "Streaming-multiprocessor clock. Sustained drops under load can indicate thermal or power capping.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_SM_CLOCK{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Memory Clock (MHz)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "expr": "DCGM_FI_DEV_MEM_CLOCK{gpu=~\"$gpu\"}",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    }
  ]
}
